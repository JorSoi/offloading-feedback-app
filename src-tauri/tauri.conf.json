{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "offloading-score-app",
  "version": "0.1.0",
  "identifier": "com.jorimsoika.offloading-score-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "offloading-score-app",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "width": 800,
        "height": 600
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["scripts/workflow_induction_bridge.py", "scripts/workflow_induction/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
